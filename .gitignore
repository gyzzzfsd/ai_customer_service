# ================= 密钥与本地配置 =================
# .env 里有数据库密码、智谱 API Key、JWT 密钥，绝不能进仓库
.env
.env.*

# ================= Python 产物 =================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ================= 测试与工具缓存 =================
.pytest_cache/
.jbeval/
.coverage
htmlcov/

# ================= IDE =================
# PyCharm 工作区配置（运行配置等属于个人环境）
.idea/

# ================= 运行时产物 =================
# 日志目录（app.log 会持续轮转增长）
logs/
*.log

# 本地临时文件
*.tmp
~

# ================= WorkBuddy 本地数据 =================
# 项目级智能体记忆，只对本机有意义
.workbuddy/
